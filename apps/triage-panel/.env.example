VITE_API_URL=http://localhost:3000
# Acesso explícito à API sintética local; desligue ao integrar o Cognito.
VITE_SYNTHETIC_AUTH=true
# Cliente público Cognito: authorization code, PKCE S256, sem client secret.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/

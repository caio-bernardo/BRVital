# Execute node scripts/setup-local.mjs para gerar .env sem sobrescrever configuração existente.
# Somente demonstração local; nenhuma combinação habilita produção.
APP_MODE=synthetic
NODE_ENV=development
PORT=3000
DATABASE_MIGRATOR_PASSWORD=
DATABASE_APP_PASSWORD=
DATABASE_MIGRATOR_URL=
DATABASE_URL=
PII_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
JWT_SECRET=
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
LOCAL_STAFF_ENABLED=true
# Opcional: Cognito access tokens; grupos precisam conter facility:<UUID da unidade>.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
